{{!-- event-material-change: cambio sustancial del evento, con ventana de reembolso abierta --}}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="supported-color-schemes" content="dark">
<title>{{changeType}} — {{eventName}}</title>
{{> styles}}
</head>
<body class="body" style="margin:0; padding:0; background-color:#050409; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <div style="display:none; max-height:0; overflow:hidden; opacity:0;">{{preheader}}</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#050409;">
    <tr>
      <td align="center" style="padding:32px 12px;">

        <table role="presentation" class="email-container" width="560" cellpadding="0" cellspacing="0" border="0" style="width:560px; max-width:560px; background-color:#0d0b12; border-radius:14px; overflow:hidden;">

          {{> header}}
          {{> hero}}

          <tr>
            <td class="px" style="padding:34px 40px;">
              <p style="margin:0 0 8px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; line-height:1.65; color:#ff2bd6;">{{changeType}}</p>

              <h1 class="h1" style="margin:0 0 18px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:28px; font-weight:800; line-height:1.15; color:#ffffff; letter-spacing:-0.2px; text-transform:uppercase;">{{eventName}}</h1>

              <p style="margin:0 0 10px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; line-height:1.6; color:#a8a4b3;">Hola, {{firstName}}</p>

              <p style="margin:0 0 0px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.65; color:#b4b0be;">{{#if isCancellation}}Lamentamos avisarte que este evento se canceló.{{else}}Te escribimos porque cambió algo del evento después de tu compra.{{/if}}</p>

{{#if changeRows.length}}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0 0; background-color:#120f18; border:1px solid #241f2e; border-radius:12px;">
                {{#each changeRows}}
                <tr>
                  <td style="padding:14px 20px; border-bottom:1px solid #241f2e;">
                    <p style="margin:0 0 6px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; font-weight:700; color:#6a6673; letter-spacing:0.08em; text-transform:uppercase;">{{this.label}}</p>
                    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:13.5px; line-height:1.5; color:#6a6673; text-decoration:line-through;">{{this.before}}</p>
                    <p style="margin:3px 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; font-weight:700; line-height:1.5; color:#ffffff;">{{this.after}}</p>
                  </td>
                </tr>
                {{/each}}
              </table>
              {{/if}}

{{#if reason}}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0 0px; background-color:#120f18; border:1px solid #241f2e; border-radius:12px;">
                <tr>
                  <td style="padding:18px 20px;">
                    <p style="margin:0 0 4px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; font-weight:700; color:#6a6673; letter-spacing:0.08em; text-transform:uppercase;">Motivo</p>
                    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.5; color:#ffffff;">{{reason}}</p>
                  </td>
                </tr>
              </table>
              {{/if}}

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0 0; background-color:#1d0c1a; border:1px solid #5c1a4d; border-radius:12px;">
                <tr>
                  <td style="padding:18px 20px;">
                    <p style="margin:0 0 6px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; font-weight:700; color:#ffffff;">Podés pedir el reembolso hasta el {{refundWindowEndsAt}}</p>
                    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:13.5px; line-height:1.6; color:#b4b0be;">Se pide desde tus compras y elegís cuáles entradas devolver.</p>
                  </td>
                </tr>
              </table>

{{#if purchasesUrl}}
              {{> button url=purchasesUrl label="Solicitar reembolso"}}
              {{> fallback-link url=purchasesUrl}}
              {{/if}}

              <p style="margin:16px 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; line-height:1.6; color:#6a6673; text-align:center;">{{#if isCancellation}}Si no pedís el reembolso dentro del plazo, escribinos a {{supportEmail}} y lo vemos.{{else}}Si no hacés nada, tu entrada sigue siendo válida para la nueva fecha.{{/if}}</p>
            </td>
          </tr>

          {{#> footer}}Recibiste este correo porque tenés entradas para este evento en {{appName}}.{{/footer}}

        </table>

      </td>
    </tr>
  </table>
</body>
</html>
