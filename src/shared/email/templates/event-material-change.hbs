{{!--
  event-material-change: aviso al comprador de un cambio material (BR-REFUND-010).

  El reembolso ya se puede pedir desde la cuenta (BR-REFUND-001), así que el
  email lleva al lugar donde se pide en vez de anunciar que "avisaremos".
--}}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{changeType}} en {{eventName}}</title>
  {{> styles}}
</head>
<body style="margin:0; padding:0; background-color:#f1f5f9; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <div style="display:none; max-height:0; overflow:hidden;">{{preheader}}</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f1f5f9; padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" class="email-container" width="600" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:16px; overflow:hidden;">
          {{> header}}

          <tr>
            <td class="mobile-padding" style="padding:32px 40px;">
              <p style="margin:0 0 6px; color:#0284c7; font-size:12px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase;">
                {{changeType}}
              </p>
              <h1 style="margin:0 0 16px; color:#0f172a; font-size:24px; font-weight:800; line-height:1.3;">
                {{eventName}}
              </h1>

              <p style="margin:0 0 20px; color:#334155; font-size:15px; line-height:1.7;">
                Hola {{firstName}}, {{#if isCancellation}}lamentamos avisarte que este evento se
                canceló.{{else}}te escribimos porque cambió algo de este evento después de tu
                compra.{{/if}}
              </p>

              {{#if changeRows.length}}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px; border:1px solid #e2e8f0; border-radius:12px; overflow:hidden;">
                {{#each changeRows}}
                <tr>
                  <td style="padding:14px 16px; background-color:#f8fafc; border-bottom:1px solid #e2e8f0;">
                    <p style="margin:0 0 6px; color:#64748b; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em;">
                      {{this.label}}
                    </p>
                    <p style="margin:0; color:#94a3b8; font-size:14px; line-height:1.5; text-decoration:line-through;">
                      {{this.before}}
                    </p>
                    <p style="margin:2px 0 0; color:#0f172a; font-size:15px; font-weight:700; line-height:1.5;">
                      {{this.after}}
                    </p>
                  </td>
                </tr>
                {{/each}}
              </table>
              {{/if}}

              {{#if reason}}
              <p style="margin:0 0 20px; color:#334155; font-size:15px; line-height:1.7;">
                <strong>Motivo:</strong> {{reason}}
              </p>
              {{/if}}

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px; background-color:#f0f9ff; border:1px solid #bae6fd; border-radius:12px;">
                <tr>
                  <td style="padding:16px 18px;">
                    <p style="margin:0 0 6px; color:#0f172a; font-size:15px; font-weight:700;">
                      Podés pedir el reembolso hasta el {{refundWindowEndsAt}}
                    </p>
                    <p style="margin:0; color:#334155; font-size:14px; line-height:1.6;">
                      Se pide desde tus compras y podés elegir cuáles entradas devolver.
                    </p>
                  </td>
                </tr>
              </table>

              {{#if purchasesUrl}}
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:8px auto 20px;">
                <tr>
                  <td align="center" style="border-radius:12px; background-color:#0284c7;">
                    <a href="{{purchasesUrl}}" target="_blank" style="display:inline-block; padding:14px 36px; font-size:15px; font-weight:700; color:#ffffff; text-decoration:none; border-radius:12px;">
                      Solicitar reembolso
                    </a>
                  </td>
                </tr>
              </table>
              {{/if}}

              <p style="margin:0; color:#64748b; font-size:13px; line-height:1.6;">
                {{#if isCancellation}}Si no pedís el reembolso dentro del plazo, escribinos desde
                Ayuda y lo vemos.{{else}}Si no hacés nada, tu entrada sigue siendo válida para la
                nueva fecha.{{/if}}
              </p>
            </td>
          </tr>

          {{> footer}}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
