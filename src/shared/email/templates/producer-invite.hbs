{{!-- producer-invite: invitación a sumarse como productor de una organización --}}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="supported-color-schemes" content="dark">
<title>Invitación a {{organizationName}}</title>
{{> styles}}
</head>
<body class="body" style="margin:0; padding:0; background-color:#050409; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <div style="display:none; max-height:0; overflow:hidden; opacity:0;">{{preheader}}</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#050409;">
    <tr>
      <td align="center" style="padding:32px 12px;">

        <table role="presentation" class="email-container" width="560" cellpadding="0" cellspacing="0" border="0" style="width:560px; max-width:560px; background-color:#0d0b12; border-radius:14px; overflow:hidden;">

          {{> header}}

          <tr>
            <td class="px" style="padding:34px 40px;">
              <p style="margin:0 0 8px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; line-height:1.65; color:#ff2bd6;">Invitación</p>

              <h1 class="h1" style="margin:0 0 18px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:28px; font-weight:800; line-height:1.15; color:#ffffff; letter-spacing:-0.2px; text-transform:uppercase;">Te sumaron a {{organizationName}}</h1>

              <p style="margin:0 0 14px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.65; color:#b4b0be;">Te invitaron a unirte como <strong style="color:#ffffff;">Productor</strong> de <strong style="color:#ffffff;">{{organizationName}}</strong> en {{appName}}.</p>

              <p style="margin:0 0 14px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.65; color:#b4b0be;">Creá tu contraseña para entrar al backoffice con los mismos permisos que el equipo principal.</p>

              {{> button url=inviteUrl label="Aceptar invitación"}}

              {{> fallback-link url=inviteUrl}}

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:28px 0 26px;"><tr><td style="height:1px; line-height:1px; font-size:0; background-color:#241f2e;">&nbsp;</td></tr></table>

              <p style="margin:0 0 16px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; font-weight:700; color:#ffffff;">Como productor vas a poder</p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td width="14" valign="top" style="padding:0 0 14px;">
                    <span style="display:inline-block; width:5px; height:5px; border-radius:3px; background-color:#ff2bd6; line-height:5px; font-size:0;">&nbsp;</span>
                  </td>
                  <td valign="top" style="padding:0 0 14px;">
                    <p style="margin:0 0 3px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; font-weight:700; color:#ffffff;">Crear y publicar eventos</p>
                    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:13.5px; line-height:1.6; color:#9d99a8;">Sectores, tandas, precios y cupones desde un solo panel.</p>
                  </td>
                </tr>
                <tr>
                  <td width="14" valign="top" style="padding:0 0 14px;">
                    <span style="display:inline-block; width:5px; height:5px; border-radius:3px; background-color:#ff2bd6; line-height:5px; font-size:0;">&nbsp;</span>
                  </td>
                  <td valign="top" style="padding:0 0 14px;">
                    <p style="margin:0 0 3px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; font-weight:700; color:#ffffff;">Seguir las ventas en vivo</p>
                    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:13.5px; line-height:1.6; color:#9d99a8;">Ingresos, gastos y caja del evento, actualizados al momento.</p>
                  </td>
                </tr>
                <tr>
                  <td width="14" valign="top" style="padding:0 0 14px;">
                    <span style="display:inline-block; width:5px; height:5px; border-radius:3px; background-color:#ff2bd6; line-height:5px; font-size:0;">&nbsp;</span>
                  </td>
                  <td valign="top" style="padding:0 0 14px;">
                    <p style="margin:0 0 3px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; font-weight:700; color:#ffffff;">Gestionar el equipo</p>
                    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:13.5px; line-height:1.6; color:#9d99a8;">Sumá validadores y cajeros con permisos acotados.</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          {{#> footer}}Recibiste este correo porque {{organizationName}} te invitó a su equipo en {{appName}}.{{/footer}}

        </table>

      </td>
    </tr>
  </table>
</body>
</html>
