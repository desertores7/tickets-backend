{{!-- ticket-email: entrega de las entradas en PDF tras la compra confirmada --}}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="supported-color-schemes" content="dark">
<title>Tus entradas para {{eventName}}</title>
{{> styles}}
</head>
<body class="body" style="margin:0; padding:0; background-color:#050409; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <div style="display:none; max-height:0; overflow:hidden; opacity:0;">{{preheader}}</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#050409;">
    <tr>
      <td align="center" style="padding:32px 12px;">

        <table role="presentation" class="email-container" width="560" cellpadding="0" cellspacing="0" border="0" style="width:560px; max-width:560px; background-color:#0d0b12; border-radius:14px; overflow:hidden;">

          {{> header}}
          {{> hero}}

          <tr>
            <td class="px" style="padding:34px 40px;">
              <p style="margin:0 0 10px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; line-height:1.6; color:#a8a4b3;">Hola, {{firstName}}</p>

              <h1 class="h1" style="margin:0 0 18px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:28px; font-weight:800; line-height:1.15; color:#ffffff; letter-spacing:-0.2px; text-transform:uppercase;">Tus entradas están listas</h1>

              <p style="margin:0 0 0px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.65; color:#b4b0be;">Tu compra fue confirmada. Adjuntamos los PDF de tus entradas para <strong style="color:#ffffff;">{{eventName}}</strong>: mostralas desde el celular o impresas en la puerta.</p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0 0; background-color:#120f18; border:1px solid #241f2e; border-radius:12px;">
                <tr>
                  <td style="padding:18px 20px;">
                    <p style="margin:0 0 8px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:17px; font-weight:700; line-height:1.3; color:#ffffff;">{{eventName}}</p>
                    <p style="margin:0 0 4px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:13.5px; color:#9d99a8;">{{eventDate}}</p>
                    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:13.5px; color:#9d99a8;">{{venueName}} · {{venueCity}}</p>
                  </td>
                </tr>
              </table>

{{#if summary}}
              <p style="margin:26px 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; font-weight:700; color:#ffffff;">Resumen de compra</p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0 0; background-color:#120f18; border:1px solid #241f2e; border-radius:12px;">
                {{#each summary.lines}}
                <tr>
                  <td style="padding:13px 20px; border-bottom:1px solid #241f2e;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; font-weight:700; color:#ffffff;">{{this.name}}<br><span style="font-size:12.5px; font-weight:400; color:#9d99a8;">{{this.detail}}</span></td>
                        <td align="right" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; font-weight:700; color:#ffffff; white-space:nowrap;">{{this.amount}}</td>
                      </tr>
                    </table>
                  </td>
                </tr>
                {{/each}}
                <tr>
                  <td style="padding:14px 20px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:13.5px; color:#9d99a8;">
                      <tr><td style="padding:3px 0;">Entradas</td><td align="right" style="padding:3px 0;">{{summary.subtotal}}</td></tr>
                      {{#if summary.hasDiscount}}<tr><td style="padding:3px 0;">Descuento</td><td align="right" style="padding:3px 0;">−{{summary.discount}}</td></tr>{{/if}}
                      <tr><td style="padding:3px 0;">Costo de servicio</td><td align="right" style="padding:3px 0;">{{summary.serviceFee}}</td></tr>
                      <tr><td style="padding:10px 0 3px; border-top:1px solid #241f2e; font-size:15px; font-weight:800; color:#ffffff;">Total pagado</td><td align="right" style="padding:10px 0 3px; border-top:1px solid #241f2e; font-size:15px; font-weight:800; color:#ffffff;">{{summary.total}}</td></tr>
                      <tr><td style="padding:10px 0 3px;">Medio de pago</td><td align="right" style="padding:10px 0 3px; color:#ffffff;">{{summary.paymentLabel}}</td></tr>
                      <tr><td style="padding:3px 0;">Cuotas</td><td align="right" style="padding:3px 0; color:#ffffff;">{{summary.installmentsLabel}}</td></tr>
                      {{#if summary.paidAt}}<tr><td style="padding:3px 0;">Fecha de pago</td><td align="right" style="padding:3px 0; color:#ffffff;">{{summary.paidAt}}</td></tr>{{/if}}
                    </table>
                  </td>
                </tr>
              </table>
{{/if}}

              <p style="margin:26px 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; font-weight:700; color:#ffffff;">Entradas ({{ticketCount}})</p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0 0; background-color:#120f18; border:1px solid #241f2e; border-radius:12px;">
                {{#each tickets}}
                <tr>
                  <td style="padding:13px 20px; border-bottom:1px solid #241f2e;">
                    <span style="font-family:'Courier New',Courier,monospace; font-size:14px; font-weight:700; color:#ffffff;">{{this.ticketNumber}}</span>
                    <span style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:13.5px; color:#9d99a8;"> — 🎟️ {{this.ticketTypeName}}</span>
                  </td>
                </tr>
                {{/each}}
              </table>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0 0px; background-color:#120f18; border:1px solid #241f2e; border-radius:12px;">
                <tr>
                  <td style="padding:18px 20px;">
                    <p style="margin:0 0 4px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; font-weight:700; color:#6a6673; letter-spacing:0.08em; text-transform:uppercase;">Orden</p>
                    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.5; color:#ffffff;">{{orderNumber}}</p>
                  </td>
                </tr>
              </table>

{{#if ticketsUrl}}
              {{> button url=ticketsUrl label="Ver mis entradas"}}
              {{/if}}

              <p style="margin:16px 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; line-height:1.6; color:#6a6673; text-align:center;">Cada entrada vale para una persona y se invalida en el primer escaneo. No compartas los códigos QR.</p>
            </td>
          </tr>

          {{#> footer}}Recibiste este correo porque compraste entradas en {{appName}}.{{/footer}}

        </table>

      </td>
    </tr>
  </table>
</body>
</html>
