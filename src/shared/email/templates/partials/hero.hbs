{{!--
  Hero visual opcional. Solo se renderiza si hay `heroUrl`: un email sin imagen
  tiene que seguir viéndose completo, porque muchos clientes bloquean imágenes
  por defecto.

  El texto va en una franja debajo de la foto y no encima: superponer texto
  sobre una imagen en email exige VML y se rompe en Outlook. `heroKicker` es
  opcional; si no viene, queda solo la foto.
--}}
{{#if heroUrl}}
<tr>
  <td style="padding:0; font-size:0; line-height:0; background-color:#0d0b12;">
    <img
      src="{{heroUrl}}"
      alt="{{#if heroAlt}}{{heroAlt}}{{else}}{{appName}}{{/if}}"
      width="560"
      style="display:block; width:100%; max-width:560px; height:auto; border:0;"
    />
  </td>
</tr>
{{#if heroKicker}}
<tr>
  <td class="px" style="background-color:#120f18; padding:14px 40px; text-align:center; border-bottom:1px solid #241f2e;">
    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; font-weight:700; color:#ffffff; letter-spacing:0.16em; text-transform:uppercase;">
      {{heroKicker}}
    </p>
  </td>
</tr>
{{/if}}
{{/if}}
