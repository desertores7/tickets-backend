{{!-- Header de marca. Opcional: un template puede no incluirlo y usar uno propio. --}}
<tr>
  <td style="background-color:#0f172a; padding:28px 40px; text-align:center;">
    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:20px; font-weight:800; color:#ffffff; letter-spacing:-0.3px;">
      {{appName}}
    </p>
    {{#if appTagline}}
    <p style="margin:6px 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; color:#94a3b8;">
      {{appTagline}}
    </p>
    {{/if}}
  </td>
</tr>
