{{!--
  Header de marca. Opcional: un template puede no incluirlo y usar uno propio.

  El logo es un PNG servido por la API (`/brand/showpass.png`): los clientes de
  correo no cargan SVG ni data URIs. Si `logoUrl` no está configurada, cae al
  nombre en texto — un header vacío se ve peor que uno sin imagen.
--}}
<tr>
  <td style="background-color:#020106; padding:28px 40px; text-align:center;">
    {{#if logoUrl}}
    <img
      src="{{logoUrl}}"
      alt="{{appName}}"
      width="160"
      style="display:block; margin:0 auto; width:160px; max-width:60%; height:auto; border:0;"
    />
    {{else}}
    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:20px; font-weight:800; color:#ffffff; letter-spacing:-0.3px;">
      {{appName}}
    </p>
    {{/if}}
    {{#if appTagline}}
    <p style="margin:10px 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; color:#8b8697;">
      {{appTagline}}
    </p>
    {{/if}}
  </td>
</tr>
