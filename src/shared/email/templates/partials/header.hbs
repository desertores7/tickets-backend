{{!--
  Header de marca: barra de acento + wordmark + bajada.

  El logo es el PNG que sirve la API (`/brand/showpass.png`) — es el mismo
  wordmark del navbar, pero los clientes de correo no cargan SVG ni data URIs.
  Si `logoUrl` no está configurada cae al nombre en texto: un header vacío se
  ve peor que uno sin imagen.

  La barra superior es un degradado; Outlook no lo renderiza, así que debajo
  queda un color sólido de respaldo.
--}}
<tr>
  <td style="height:4px; line-height:4px; font-size:0; background-color:#ff2bd6; background-image:linear-gradient(90deg,#ff2bd6 0%,#8b5cf6 55%,#22d3ee 100%);">&nbsp;</td>
</tr>
<tr>
  <td class="px" style="background-color:#0d0b12; padding:36px 40px 26px; text-align:center;">
    {{#if logoUrl}}
    <img
      src="{{logoUrl}}"
      alt="{{appName}}"
      width="150"
      style="display:block; margin:0 auto; width:150px; max-width:62%; height:auto; border:0;"
    />
    {{else}}
    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:24px; font-weight:800; color:#ffffff; letter-spacing:-0.4px;">
      {{appName}}
    </p>
    {{/if}}
    {{#if appTagline}}
    <p style="margin:14px 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:11px; font-weight:600; color:#8b8697; letter-spacing:0.22em; text-transform:uppercase;">
      {{appTagline}}
    </p>
    {{/if}}
  </td>
</tr>
