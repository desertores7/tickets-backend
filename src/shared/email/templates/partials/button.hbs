{{!--
  CTA principal. Ancho completo del contenido para que el bloque tenga el mismo
  peso visual en todos los templates.

  Uso: {{> button url=loginUrl label="Iniciar sesión"}}
--}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:26px 0 0;">
  <tr>
    <td align="center" bgcolor="#ff2bd6" style="border-radius:10px; background-color:#ff2bd6;">
      <a href="{{url}}" target="_blank" style="display:block; padding:16px 24px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; font-weight:700; color:#ffffff; text-decoration:none; border-radius:10px; text-align:center;">
        {{label}}
      </a>
    </td>
  </tr>
</table>
