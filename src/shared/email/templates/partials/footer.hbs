{{!-- Footer de marca. Opcional por template. --}}
<tr>
  <td style="background-color:#f8fafc; padding:20px 40px; text-align:center; border-top:1px solid #e2e8f0;">
    <p style="margin:0 0 8px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; color:#94a3b8;">
      {{appName}} · {{year}}
    </p>
    {{#if supportEmail}}
    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; color:#94a3b8;">
      ¿Necesitás ayuda? <a href="mailto:{{supportEmail}}" style="color:#0284c7; text-decoration:none;">{{supportEmail}}</a>
    </p>
    {{/if}}
  </td>
</tr>
