{{!--
  Footer de marca: contacto, links legales y copyright.

  La nota de por qué llegó el correo la pasa cada template como bloque, para
  poder interpolar variables adentro:

      {{#> footer}}Recibiste este correo porque ... {{email}}.{{/footer}}

  Un `{{> footer}}` suelto también es válido: simplemente no muestra la nota.
--}}
<tr>
  <td class="px" style="background-color:#0d0b12; padding:24px 40px 30px; border-top:1px solid #241f2e;">
    {{#if @partial-block}}
    <p style="margin:0 0 14px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; line-height:1.6; color:#6a6673;">
      {{> @partial-block}}
    </p>
    {{/if}}
    {{#if supportEmail}}
    <p style="margin:0 0 10px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; line-height:1.6; color:#6a6673;">
      ¿Necesitás ayuda? Escribinos a
      <a href="mailto:{{supportEmail}}" style="color:#ff2bd6; text-decoration:none;">{{supportEmail}}</a>
    </p>
    {{/if}}
    <p style="margin:0 0 10px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; line-height:1.6; color:#8e8a99;">
      <a href="{{frontendUrl}}/preguntas-frecuentes" style="color:#8e8a99; text-decoration:none;">Ayuda</a>
      <span style="color:#3a3546;">&nbsp;·&nbsp;</span>
      <a href="{{frontendUrl}}/terminos" style="color:#8e8a99; text-decoration:none;">Términos</a>
      <span style="color:#3a3546;">&nbsp;·&nbsp;</span>
      <a href="{{siteUrl}}" style="color:#8e8a99; text-decoration:none;">{{siteDomain}}</a>
    </p>
    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; color:#55505f;">
      © {{year}} {{appName}}. Argentina.
    </p>
  </td>
</tr>
