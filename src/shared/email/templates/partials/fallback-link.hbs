{{!--
  Nota bajo el CTA: el enlace en texto plano, para cuando el cliente de correo
  bloquea el botón. Uso: {{> fallback-link url=loginUrl}}
--}}
<p style="margin:14px 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; line-height:1.6; color:#6a6673; text-align:center;">
  Si el botón no funciona, copiá y pegá este enlace:<br />
  <a href="{{url}}" style="color:#8e8a99; word-break:break-all;">{{url}}</a>
</p>
