{{!-- organization-rejected: productora rechazada por Admin --}}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Productora rechazada</title>
  {{> styles}}
</head>
<body style="margin:0; padding:0; background-color:#f1f5f9; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <div style="display:none; max-height:0; overflow:hidden;">{{preheader}}</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f1f5f9; padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" class="email-container" width="600" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:16px; overflow:hidden;">
          {{> header}}

          <tr>
            <td class="mobile-padding" style="padding:32px 40px;">
              <h1 style="margin:0 0 12px; color:#0f172a; font-size:24px; font-weight:800;">
                Validación rechazada
              </h1>
              <p style="margin:0 0 16px; color:#334155; font-size:15px; line-height:1.7;">
                Hola {{firstName}},
              </p>
              <p style="margin:0 0 16px; color:#334155; font-size:15px; line-height:1.7;">
                Revisamos los datos fiscales de <strong>{{organizationName}}</strong> y por ahora no pudimos aprobarla.
              </p>
              <p style="margin:0 0 8px; color:#334155; font-size:15px; line-height:1.7;">
                <strong>Motivo:</strong>
              </p>
              <p style="margin:0 0 24px; padding:12px 16px; background-color:#fef2f2; border-radius:8px; color:#991b1b; font-size:14px; line-height:1.6;">
                {{rejectionReason}}
              </p>
              <p style="margin:0 0 24px; color:#334155; font-size:15px; line-height:1.7;">
                Podés corregir la información en Datos fiscales y volver a enviar la solicitud.
              </p>

              <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:8px auto 20px;">
                <tr>
                  <td align="center" style="border-radius:12px; background-color:#0284c7;">
                    <a href="{{fiscalUrl}}" target="_blank" style="display:inline-block; padding:14px 36px; font-size:15px; font-weight:700; color:#ffffff; text-decoration:none; border-radius:12px;">
                      Ir a datos fiscales
                    </a>
                  </td>
                </tr>
              </table>

              <p style="margin:0; color:#64748b; font-size:13px; line-height:1.6;">
                Si el botón no funciona: <a href="{{fiscalUrl}}" style="color:#0284c7; word-break:break-all;">{{fiscalUrl}}</a>
              </p>
            </td>
          </tr>

          {{> footer}}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
