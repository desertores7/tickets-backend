{{!-- organization-rejected: la validación fiscal no pasó, con el motivo --}}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="supported-color-schemes" content="dark">
<title>Validación rechazada</title>
{{> styles}}
</head>
<body class="body" style="margin:0; padding:0; background-color:#050409; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <div style="display:none; max-height:0; overflow:hidden; opacity:0;">{{preheader}}</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#050409;">
    <tr>
      <td align="center" style="padding:32px 12px;">

        <table role="presentation" class="email-container" width="560" cellpadding="0" cellspacing="0" border="0" style="width:560px; max-width:560px; background-color:#0d0b12; border-radius:14px; overflow:hidden;">

          {{> header}}

          <tr>
            <td class="px" style="padding:34px 40px;">
              <p style="margin:0 0 10px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; line-height:1.6; color:#a8a4b3;">Hola, {{firstName}}</p>

              <h1 class="h1" style="margin:0 0 18px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:28px; font-weight:800; line-height:1.15; color:#ffffff; letter-spacing:-0.2px; text-transform:uppercase;">No pudimos aprobar {{organizationName}}</h1>

              <p style="margin:0 0 0px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.65; color:#b4b0be;">Revisamos los datos fiscales de <strong style="color:#ffffff;">{{organizationName}}</strong> y por ahora no podemos habilitarla.</p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0 0; background-color:#1b1016; border:1px solid #4a1f2c; border-radius:12px;">
                <tr>
                  <td style="padding:18px 20px;">
                    <p style="margin:0 0 4px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; font-weight:700; color:#f87171; letter-spacing:0.08em; text-transform:uppercase;">Motivo</p>
                    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.6; color:#ffffff;">{{rejectionReason}}</p>
                  </td>
                </tr>
              </table>

              <p style="margin:0 0 0px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.65; color:#b4b0be;">Corregí la información en Datos fiscales y volvé a enviar la solicitud: la revisamos de nuevo apenas llegue.</p>

              {{> button url=fiscalUrl label="Ir a datos fiscales"}}

              {{> fallback-link url=fiscalUrl}}
            </td>
          </tr>

          {{#> footer}}Recibiste este correo porque administrás {{organizationName}} en {{appName}}.{{/footer}}

        </table>

      </td>
    </tr>
  </table>
</body>
</html>
