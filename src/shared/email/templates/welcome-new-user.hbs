{{!-- welcome-new-user: cuenta ya activa (alta hecha por un administrador) --}}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="supported-color-schemes" content="dark">
<title>Bienvenido a {{appName}}</title>
{{> styles}}
</head>
<body class="body" style="margin:0; padding:0; background-color:#050409; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <div style="display:none; max-height:0; overflow:hidden; opacity:0;">{{preheader}}</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#050409;">
    <tr>
      <td align="center" style="padding:32px 12px;">

        <table role="presentation" class="email-container" width="560" cellpadding="0" cellspacing="0" border="0" style="width:560px; max-width:560px; background-color:#0d0b12; border-radius:14px; overflow:hidden;">

          {{> header}}
          {{> hero}}

          <tr>
            <td class="px" style="padding:34px 40px;">
              <p style="margin:0 0 10px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; line-height:1.6; color:#a8a4b3;">Hola, {{firstName}} {{lastName}}</p>

              <h1 class="h1" style="margin:0 0 18px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:28px; font-weight:800; line-height:1.15; color:#ffffff; letter-spacing:-0.2px; text-transform:uppercase;">Tu cuenta ya está activa</h1>

              <p style="margin:0 0 14px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.65; color:#b4b0be;">Ya podés ingresar a {{appName}} y empezar a comprar entradas para tus próximos shows.</p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0 0px; background-color:#120f18; border:1px solid #241f2e; border-radius:12px;">
                <tr>
                  <td style="padding:18px 20px;">
                    <p style="margin:0 0 4px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; font-weight:700; color:#6a6673; letter-spacing:0.08em; text-transform:uppercase;">Usuario registrado</p>
                    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.5; color:#ffffff;">{{email}}</p>
                  </td>
                </tr>
              </table>

              {{> button url=loginUrl label="Iniciar sesión"}}

              {{> fallback-link url=loginUrl}}

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:28px 0 26px;"><tr><td style="height:1px; line-height:1px; font-size:0; background-color:#241f2e;">&nbsp;</td></tr></table>

              <p style="margin:0 0 16px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; font-weight:700; color:#ffffff;">Lo que tenés a mano</p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td width="14" valign="top" style="padding:0 0 14px;">
                    <span style="display:inline-block; width:5px; height:5px; border-radius:3px; background-color:#ff2bd6; line-height:5px; font-size:0;">&nbsp;</span>
                  </td>
                  <td valign="top" style="padding:0 0 14px;">
                    <p style="margin:0 0 3px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; font-weight:700; color:#ffffff;">Tus entradas, siempre con vos</p>
                    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:13.5px; line-height:1.6; color:#9d99a8;">QR en la cuenta y PDF descargable para cada ticket.</p>
                  </td>
                </tr>
                <tr>
                  <td width="14" valign="top" style="padding:0 0 14px;">
                    <span style="display:inline-block; width:5px; height:5px; border-radius:3px; background-color:#ff2bd6; line-height:5px; font-size:0;">&nbsp;</span>
                  </td>
                  <td valign="top" style="padding:0 0 14px;">
                    <p style="margin:0 0 3px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; font-weight:700; color:#ffffff;">Historial de compras</p>
                    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:13.5px; line-height:1.6; color:#9d99a8;">Todas tus órdenes, con estado y comprobantes.</p>
                  </td>
                </tr>
                <tr>
                  <td width="14" valign="top" style="padding:0 0 14px;">
                    <span style="display:inline-block; width:5px; height:5px; border-radius:3px; background-color:#ff2bd6; line-height:5px; font-size:0;">&nbsp;</span>
                  </td>
                  <td valign="top" style="padding:0 0 14px;">
                    <p style="margin:0 0 3px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; font-weight:700; color:#ffffff;">Ayuda cuando la necesites</p>
                    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:13.5px; line-height:1.6; color:#9d99a8;">Escribinos y te respondemos desde el mismo lugar.</p>
                  </td>
                </tr>
              </table>

              <p style="margin:22px 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; font-weight:700;"><a href="{{frontendUrl}}/events" style="color:#ff2bd6; text-decoration:none;">Explorar eventos &rarr;</a></p>
            </td>
          </tr>

          {{#> footer}}Recibiste este correo porque se creó una cuenta en {{appName}} con {{email}}.{{/footer}}

        </table>

      </td>
    </tr>
  </table>
</body>
</html>
