{{!-- refund-result: resultado de un pedido de reembolso (aprobado o rechazado) --}}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="supported-color-schemes" content="dark">
<title>{{#if approved}}Reembolso aprobado{{else}}Tu pedido de reembolso{{/if}}</title>
{{> styles}}
</head>
<body class="body" style="margin:0; padding:0; background-color:#050409; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <div style="display:none; max-height:0; overflow:hidden; opacity:0;">{{#if approved}}Aprobamos tu reembolso de {{eventName}}{{else}}Novedades sobre tu pedido de reembolso{{/if}}</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#050409;">
    <tr>
      <td align="center" style="padding:32px 12px;">

        <table role="presentation" class="email-container" width="560" cellpadding="0" cellspacing="0" border="0" style="width:560px; max-width:560px; background-color:#0d0b12; border-radius:14px; overflow:hidden;">

          {{> header}}

          <tr>
            <td class="px" style="padding:34px 40px;">
{{#if firstName}}
              <p style="margin:0 0 10px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; line-height:1.6; color:#a8a4b3;">Hola, {{firstName}}</p>
              {{/if}}

              <h1 class="h1" style="margin:0 0 18px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:28px; font-weight:800; line-height:1.15; color:#ffffff; letter-spacing:-0.2px; text-transform:uppercase;">{{#if approved}}Reembolso aprobado{{else}}No pudimos aprobar tu reembolso{{/if}}</h1>

{{#if approved}}
              <p style="margin:0 0 0px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.65; color:#b4b0be;">Aprobamos el reembolso de <strong style="color:#ffffff;">{{ticketLabel}}</strong> de <strong style="color:#ffffff;">{{eventName}}</strong>.</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0 0; background-color:#120f18; border:1px solid #241f2e; border-radius:12px;">
                <tr>
                  <td align="center" style="padding:22px 20px;">
                    <p style="margin:0 0 6px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; font-weight:700; color:#6a6673; letter-spacing:0.08em; text-transform:uppercase;">Te reintegramos</p>
                    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:30px; font-weight:800; color:#ffffff;">{{currency}} {{amount}}</p>
                  </td>
                </tr>
              </table>
              <p style="margin:0 0 0px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.65; color:#b4b0be;">Vuelve al mismo medio de pago con el que compraste, dentro de las próximas <strong style="color:#ffffff;">48 horas</strong>. Según tu banco puede tardar algunos días más en aparecer en el resumen.</p>
              {{else}}
              <p style="margin:0 0 0px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.65; color:#b4b0be;">Revisamos tu pedido de reembolso de <strong style="color:#ffffff;">{{eventName}}</strong> y no pudimos aprobarlo.</p>
              {{#if reason}}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0 0px; background-color:#120f18; border:1px solid #241f2e; border-radius:12px;">
                <tr>
                  <td style="padding:18px 20px;">
                    <p style="margin:0 0 4px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; font-weight:700; color:#6a6673; letter-spacing:0.08em; text-transform:uppercase;">Motivo</p>
                    <p style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.5; color:#ffffff;">{{reason}}</p>
                  </td>
                </tr>
              </table>
              {{/if}}
              <p style="margin:0 0 0px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.65; color:#b4b0be;">Tus entradas siguen siendo válidas. Si creés que hubo un error, escribinos a {{supportEmail}} y lo miramos.</p>
              {{/if}}

{{#if ticketsUrl}}
              {{> button url=ticketsUrl label="Ver mis entradas"}}
              {{> fallback-link url=ticketsUrl}}
              {{/if}}
            </td>
          </tr>

          {{#> footer}}Recibiste este correo porque pediste un reembolso en {{appName}}.{{/footer}}

        </table>

      </td>
    </tr>
  </table>
</body>
</html>
