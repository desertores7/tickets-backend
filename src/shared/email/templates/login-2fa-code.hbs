{{!-- login-2fa-code: código de verificación en dos pasos para iniciar sesión --}}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="supported-color-schemes" content="dark">
<title>Código de acceso</title>
{{> styles}}
</head>
<body class="body" style="margin:0; padding:0; background-color:#050409; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <div style="display:none; max-height:0; overflow:hidden; opacity:0;">{{preheader}}</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#050409;">
    <tr>
      <td align="center" style="padding:32px 12px;">

        <table role="presentation" class="email-container" width="560" cellpadding="0" cellspacing="0" border="0" style="width:560px; max-width:560px; background-color:#0d0b12; border-radius:14px; overflow:hidden;">

          {{> header}}

          <tr>
            <td class="px" style="padding:34px 40px;">
              <p style="margin:0 0 10px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:14px; line-height:1.6; color:#a8a4b3;">Hola, {{firstName}}</p>

              <h1 class="h1" style="margin:0 0 18px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:28px; font-weight:800; line-height:1.15; color:#ffffff; letter-spacing:-0.2px; text-transform:uppercase;">Tu código de acceso</h1>

              <p style="margin:0 0 0px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:15px; line-height:1.65; color:#b4b0be;">Usá este código para completar el ingreso a tu cuenta de {{appName}}.</p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0 0;">
                <tr>
                  <td align="center" style="padding:22px 16px; background-color:#17121f; border:1px solid #3a2340; border-radius:12px;">
                    <span style="font-family:'Courier New',Courier,monospace; font-size:34px; font-weight:700; letter-spacing:10px; color:#ffffff;">{{code}}</span>
                  </td>
                </tr>
              </table>

              <p style="margin:18px 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:12px; line-height:1.6; color:#6a6673; text-align:center;">El código vence en 5 minutos y sirve para un solo ingreso.</p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:28px 0 26px;"><tr><td style="height:1px; line-height:1px; font-size:0; background-color:#241f2e;">&nbsp;</td></tr></table>

              <p style="margin:0 0 0px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; font-size:13px; line-height:1.65; color:#9d99a8;">Si no intentaste iniciar sesión, ignorá este correo y cambiá tu contraseña por las dudas. Nadie de {{appName}} te va a pedir este código.</p>
            </td>
          </tr>

          {{#> footer}}Recibiste este correo porque se pidió un código de acceso para tu cuenta.{{/footer}}

        </table>

      </td>
    </tr>
  </table>
</body>
</html>
