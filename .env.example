# =============================================================================
# Ticketera Backend — variables de entorno
# Copia este archivo como `.env` y completa los valores.
# =============================================================================

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
# Puerto HTTP (por defecto: 3005)
PORT=3005

# Entorno de la aplicación: local | dev | prod
ENV=local

# Entorno de Node.js: development | production | test
NODE_ENV=development

# URL pública del backend (Swagger, URLs de imágenes, etc.)
BASE_URL=http://localhost:3005

# URL del frontend (enlaces en emails, CORS)
FRONTEND_URL=http://localhost:3000

# Orígenes permitidos para CORS (separados por coma).
# localhost y 127.0.0.1 siempre están permitidos, no hace falta listarlos.
# Se admite `*` como comodín de UN segmento de subdominio (no cruza puntos):
#   https://mi-proyecto-*.vercel.app  → acepta los preview deploys de ese proyecto
#   https://*.vercel.app              → acepta CUALQUIER app de Vercel (evitar en prod)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3005

# -----------------------------------------------------------------------------
# Base de datos (MySQL) — OBLIGATORIO
# -----------------------------------------------------------------------------
# JSON con los datos de conexión. Las contraseñas con "$" deben ir sin comillas
# extra; el proyecto desactiva expandVariables para no corromperlas.
DB_CONNECTION_DATA={"host":"localhost","port":3306,"username":"root","password":"tu_password","database":"ticketera"}

# Nombre de base de datos de respaldo (opcional, usado en metadatos internos)
# DB_FALLBACK_NAME=ticketera

# -----------------------------------------------------------------------------
# Autenticación JWT — OBLIGATORIO
# -----------------------------------------------------------------------------
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_este_otro_secreto_por_uno_largo_y_aleatorio

# Duración de los tokens (formato: 15m, 12h, 7d, etc.)
# Access corto (seguridad) + refresh ~12h (sesión de un día web sin re-login).
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=12h

# -----------------------------------------------------------------------------
# Email (SMTP) — opcional; necesario para recuperación de contraseña y verificación
# -----------------------------------------------------------------------------
# HOST_EMAIL=smtp.gmail.com
# PORT_EMAIL=587
# USERNAME_EMAIL=tu_email@ejemplo.com
# PASSWORD_EMAIL=tu_password_de_aplicacion

# -----------------------------------------------------------------------------
# Email transaccional de tickets (Gmail SMTP, MVP) — módulo notifications
# -----------------------------------------------------------------------------
# Si no se definen, el módulo usa las variables *_EMAIL de arriba como fallback.
# Gmail requiere contraseña de aplicación (no la contraseña de la cuenta).
# Límite de Gmail: ~500 emails/día — migrar a proveedor transaccional en producción.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_email@gmail.com
# SMTP_PASSWORD=contraseña_de_aplicacion
# SMTP_FROM_NAME=Ticketera
# SMTP_FROM_EMAIL=tu_email@gmail.com

# Destino del formulario de contacto (Ayuda). Si no está, se usa SMTP_FROM_EMAIL / SMTP_USER.
# SUPPORT_EMAIL=soporte@tudominio.com

# -----------------------------------------------------------------------------
# Redis — OBLIGATORIO para BullMQ, stock y sala de espera
# -----------------------------------------------------------------------------
# Opción A — URL completa (tiene precedencia sobre host/puerto)
# REDIS_URL=redis://:mi_password@127.0.0.1:6379/0

# Opción B — IP/host y puerto (recomendado)
# Local (app fuera de Docker):
REDIS_IP=127.0.0.1
REDIS_PORT=6379
# REDIS_HOST=localhost          # alternativa a REDIS_IP (REDIS_IP tiene prioridad)
# REDIS_PASSWORD=

# Docker — Redis en otro contenedor de la misma red (NO uses 127.0.0.1):
# REDIS_IP=redis-ta63-redis-1   # nombre del contenedor o alias del servicio en compose
# REDIS_PORT=6379               # puerto interno del contenedor (no el mapeado al host, ej. 32768)

# -----------------------------------------------------------------------------
# MercadoPago — opcional en local, obligatorio en producción
# -----------------------------------------------------------------------------
# Token de acceso de la aplicación (Panel MP → Credenciales → Producción/Prueba)
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# Secreto para validar la firma HMAC-SHA256 de los webhooks (Panel MP → Webhooks)
# MERCADOPAGO_WEBHOOK_SECRET=abc123...

# URL base del backend expuesta públicamente.
# Se usa para construir automáticamente:
#   - notification_url → ${APP_URL}/api/v1/payments/webhook/mercadopago
#   - back_urls         → ${APP_URL}/payment/success|failure|pending
# En local usar ngrok u otro tunnel; en prod la URL del servidor.
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Almacenamiento de archivos — opcional; default: ./storage
# -----------------------------------------------------------------------------
# Ruta base donde se guardan los archivos generados (QR PNGs, PDFs de tickets).
# Estructura creada automáticamente al iniciar:
#   <STORAGE_PATH>/tickets/qr/   ← imágenes PNG de los QR
#   <STORAGE_PATH>/tickets/pdf/  ← PDFs de los tickets
# En producción usar una ruta absoluta o un volumen montado (ej. /var/data/storage).
STORAGE_PATH=./storage

# -----------------------------------------------------------------------------
# QR — OBLIGATORIO en producción
# -----------------------------------------------------------------------------
# Secret HMAC-SHA256 para firmar los tokens QR (mínimo 32 caracteres).
# Cambiar este valor invalida todos los QR ya emitidos — NO rotar en producción
# salvo como respuesta a un incidente de seguridad.
QR_SECRET=cambia_esto_por_una_cadena_de_al_menos_32_caracteres

# -----------------------------------------------------------------------------
# OpenAI — opcional; requerido para POST /events/ai/from-flyers
# -----------------------------------------------------------------------------
# API key de OpenAI (solo backend; nunca NEXT_PUBLIC_*).
# Sin esta variable el endpoint de IA responde 503.
# OPENIA_API_KEY=

# Modelos (defaults actuales).
# EVENT_AI_EXTRACT_MODEL=gpt-4o
# Modelo EXCLUSIVO de POST /events/ai/from-map (visión → layout; el frontend arma el SVG).
# No se mezcla con EVENT_AI_EXTRACT_MODEL. Recomendado: gpt-5.6-sol
# EVENT_AI_MAP_MODEL=gpt-5.6-sol
# reasoning_effort del mapa (none|minimal|low|medium|high|xhigh|max). Default high.
# EVENT_AI_MAP_REASONING_EFFORT=medium
# EVENT_AI_IMAGE_MODEL=gpt-image-2
# Fallback opcional ante 429/5xx. Vacío = sin fallback (recomendado para hero).
# No uses gpt-image-1-mini acá: baja mucho la fidelidad de caras/logos.
# EVENT_AI_IMAGE_FALLBACK_MODEL=

# Salida images.edit (gpt-image-2 acepta resoluciones custom WIDTHxHEIGHT, múltiplos de 16).
# EVENT_AI_IMAGE_SIZE=2048x1152
# EVENT_AI_IMAGE_QUALITY=low
# EVENT_AI_IMAGE_FORMAT=webp
# EVENT_AI_IMAGE_COMPRESSION=80


# Cupo horario por usuario (Redis). 0 = sin límite. En prod podés poner p. ej. 5.
# EVENT_AI_MAX_PER_HOUR=0

# -----------------------------------------------------------------------------
# OAuth Google — inicio de sesión / registro con Google
# -----------------------------------------------------------------------------
# Client ID y Client Secret de la app en Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Web application)
# GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# URL que Google redirige tras el consentimiento. Debe estar registrada en
# Google Cloud Console → Authorized redirect URIs del OAuth client.
# Local:  http://localhost:3005/api/v1/auth/google/callback
# Prod:   https://tu-backend.com/api/v1/auth/google/callback
# GOOGLE_CALLBACK_URL=http://localhost:3005/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# Alertas (opcional)
# -----------------------------------------------------------------------------
# Webhook de Discord para errores críticos (unhandledRejection, bootstrap, etc.)
# DISCORD_WEBHOOK_ALERTS=https://discord.com/api/webhooks/...

# -----------------------------------------------------------------------------
# Logging externo (opcional, definido en el esquema pero no usado actualmente)
# -----------------------------------------------------------------------------
# LOG_FUNCTION_URL=
# LOG_SERVICE=
